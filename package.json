{
  "name": "menu-moments",
  "version": "1.0.0",
  "private": true,
  "description": "Menu Moments — food, recipes, kitchen guides",
  "scripts": {
    "predev": "node scripts/export-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/export-content.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate-wp.mjs && node scripts/clean-content.mjs && node scripts/download-images.mjs && node scripts/audit-affiliates.mjs",
    "migrate:text": "node scripts/migrate-wp.mjs",
    "migrate:clean": "node scripts/clean-content.mjs",
    "migrate:images": "node scripts/download-images.mjs",
    "migrate:audit": "node scripts/audit-affiliates.mjs",
    "migrate:xml": "node scripts/merge-wp-export.mjs",
    "amazon:resolve": "node scripts/resolve-amazon-links.mjs",
    "amazon:retag": "node scripts/retag-amazon-links.mjs",
    "amazon:check": "node scripts/retag-amazon-links.mjs --dry-run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "clsx": "2.1.1",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "5.7.2",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
