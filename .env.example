NEXT_PUBLIC_SITE_URL=https://menumoments.com

# WordPress is now the migration source only. Run scripts/migrate-wp.mjs
# to snapshot all posts into src/content/posts/. The site prefers local
# content by default and only falls back to WP for slugs that haven't
# been migrated yet.
WORDPRESS_API_URL=https://menumoments.com/wp-json/wp/v2

# `local` = local JSON only (recommended, self-hosting)
# `hybrid` = local first, then live WP fallback
# `wordpress` = live WP only (dev/preview against production content)
CONTENT_SOURCE=local

# Revalidate interval (seconds) for ISR fallbacks
REVALIDATE_SECONDS=3600

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# Publisher ID from AdSense → Account → Account information (with the ca-pub- prefix).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7608644006230459

# Auto Ads: let AdSense decide placements. 'true' or 'false'.
NEXT_PUBLIC_ADSENSE_AUTO_ADS=true

# Manual ad-unit slot IDs (create these in AdSense → Ads → Ad units).
# Leave blank to hide that placement. Slot IDs are numeric strings, e.g. 1234567890.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ---------------------------------------------------------------------------
# Amazon Associates
# ---------------------------------------------------------------------------
# Tracking ID every affiliate link should carry. Used by the retag scripts
# (npm run amazon:check / amazon:retag), not by the app at runtime.
AMAZON_TAG=nomi06d06-20

# ---------------------------------------------------------------------------
# Admin panel (HTTP Basic Auth on /admin/*)
# ---------------------------------------------------------------------------
# Both must be set — if either is missing, /admin returns 503.
# Use a strong password on production.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
