{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menumoments",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "menumoments"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "menumoments.com", "custom_domain": true },
    { "pattern": "www.menumoments.com", "custom_domain": true }
  ],
  // Keep variables added in the dashboard (e.g. GITHUB_TOKEN) across deploys.
  "keep_vars": true,
  "vars": {
    "GITHUB_REPO": "noumanbilal100/menumoments",
    "GITHUB_BRANCH": "main"
  },
  "observability": {
    "enabled": true
  }
}
